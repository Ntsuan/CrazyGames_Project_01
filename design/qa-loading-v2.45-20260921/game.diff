+const boot={phase:"cover",assets:[],batch:null,resetRequested:false,slowTimer:0,audioUrl:null};
+function makeBootAssets(){
+  return [...new Set(BOOT_IMAGES)].map(url=>({url,type:"image",state:"pending"})).concat(
+    {url:SFX_SRC,type:"audio",state:"pending"},
+    Array.from(document.querySelectorAll('link[rel="stylesheet"]')).map(link=>({url:link.href,type:"style",link,state:"pending"}))
+  );
+}
+function loadBootAsset(asset){
+  return new Promise((resolve,reject)=>{
+    let settled=false, image=null, controller=null, cleanup=()=>{};
+    const finish=error=>{
+      if(settled) return; settled=true; clearTimeout(timer); cleanup();
+      if(error){ controller?.abort(); if(image) image.src=""; reject(error); }
+      else resolve();
+    };
+    const timer=setTimeout(()=>finish(new Error("素材加载超时")),20000);
+    if(asset.type==="image"){
+      image=new Image();
+      cleanup=()=>{image.onload=null;image.onerror=null;};
+      image.onload=async()=>{
+        try{ if(image.decode) await image.decode(); if(!settled){asset.image=image;finish();} }
+        catch(error){finish(error);}
+      };
+      image.onerror=()=>finish(new Error("图片加载失败"));
+      image.src=asset.url;
+    } else if(asset.type==="audio"){
+      // 完整下载后复用本地 Blob，避免移动端等待自动播放许可而卡住加载。
+      controller=new AbortController();
+      fetch(asset.url,{signal:controller.signal}).then(response=>{
+        if(!response.ok) throw new Error("音效加载失败"); return response.blob();
+      }).then(blob=>{
+        if(settled) return;
+        if(!blob.size) throw new Error("音效为空");
+        boot.audioUrl=URL.createObjectURL(blob);
+        sfxPool.forEach(a=>{a.src=boot.audioUrl;a.load();}); finish();
+      }).catch(finish);
+    } else {
+      const link=asset.link;
+      if(link.sheet){finish();return;}
+      const loaded=()=>finish(), failed=()=>finish(new Error("样式加载失败"));
+      link.addEventListener("load",loaded); link.addEventListener("error",failed);
+      cleanup=()=>{link.removeEventListener("load",loaded);link.removeEventListener("error",failed);};
+      // 脚本运行前已失败的样式也能重试；保留原节点和 CSS 层叠顺序。
+      const url=new URL(asset.url,document.baseURI); url.searchParams.set("loadAttempt",String(asset.attempts)); link.href=url.href;
+    }
+  });
+}
+function updateLoadingUI(message){
+  if(boot.phase!=="loading") return;
+  const ready=boot.assets.filter(a=>a.state==="ready").length;
+  const percent=boot.assets.length?Math.floor(ready/boot.assets.length*100):0;
+  $("loadingFill").style.width=percent+"%";
+  $("loadingPercent").textContent=percent+"%";
+  $("loadingProgress").setAttribute("aria-valuenow",String(percent));
+  if(message) $("loadingStatus").textContent=message;
+}
+function prepareAssets(){
+  if(boot.batch) return boot.batch;
+  if(!boot.assets.length) boot.assets=makeBootAssets();
+  const queue=boot.assets.filter(a=>a.state!=="ready");
+  async function worker(){
+    while(queue.length){
+      const asset=queue.shift(); asset.state="loading"; asset.attempts=(asset.attempts||0)+1;
+      try{ await loadBootAsset(asset); asset.state="ready"; }
+      catch(error){asset.state="failed";}
+      updateLoadingUI();
+    }
+  }
+  boot.batch=Promise.all(Array.from({length:Math.min(6,queue.length)},worker)).finally(()=>{boot.batch=null;});
+  return boot.batch;
+}
+async function startCoverLoad(reset=false){
